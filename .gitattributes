# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts should use LF
*.sh text eol=lf

# Windows scripts should use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Python files should use LF
*.py text eol=lf

# Docker files should use LF
Dockerfile text eol=lf
docker-compose.yml text eol=lf
.dockerignore text eol=lf

# Markdown files
*.md text eol=lf

# YAML files
*.yml text eol=lf
*.yaml text eol=lf

# JSON files
*.json text eol=lf

# Binary files
*.pkl binary
*.zip binary
*.csv binary
*.xlsx binary
*.xls binary
